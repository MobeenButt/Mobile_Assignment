<?xml version="1.0" encoding="utf-8"?>
<!-- Shared dark background with faint diagonal gradient overlay -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#07070F" />
        </shape>
    </item>
    <!-- Top-left gold warmth -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="50%p"
                android:centerX="0.1"
                android:centerY="0.0"
                android:startColor="#12F0B429"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Bottom-right blue coolness -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="45%p"
                android:centerX="0.95"
                android:centerY="1.0"
                android:startColor="#100EA5E9"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>

