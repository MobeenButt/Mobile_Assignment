<?xml version="1.0" encoding="utf-8"?>
<!-- Gold outlined pill button (secondary / back-home) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="#1AF0B429" />
            <stroke android:width="1.5dp" android:color="#F5C84A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="#0DF0B429" />
            <stroke android:width="1.5dp" android:color="#F0B429" />
        </shape>
    </item>
</selector>

