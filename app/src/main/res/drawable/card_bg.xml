<?xml version="1.0" encoding="utf-8"?>
<!-- Dark card with subtle gold-top shimmer + border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main card body -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#131325" />
            <stroke android:width="1dp" android:color="#252545" />
        </shape>
    </item>
    <!-- Top-edge gold highlight shimmer -->
    <item
        android:left="48dp"
        android:right="48dp"
        android:bottom="18dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="20dp" android:topRightRadius="20dp"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
            <gradient
                android:angle="0"
                android:startColor="#00F0B429"
                android:centerColor="#30F0B429"
                android:endColor="#00F0B429" />
        </shape>
    </item>
</layer-list>

