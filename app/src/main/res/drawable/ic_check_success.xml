<?xml version="1.0" encoding="utf-8"?>
<!-- Success checkmark in a circle with emerald glow -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Outer glow fill -->
    <path android:fillColor="#2010B981"
        android:pathData="M50,5 A45,45 0 1,0 50,95 A45,45 0 1,0 50,5 Z" />

    <!-- Circle border -->
    <path android:strokeColor="#10B981"
        android:strokeWidth="2.5"
        android:fillColor="#10131325"
        android:pathData="M50,10 A40,40 0 1,0 50,90 A40,40 0 1,0 50,10 Z" />

    <!-- Inner ring accent -->
    <path android:strokeColor="#4010B981"
        android:strokeWidth="1"
        android:fillColor="#00000000"
        android:pathData="M50,17 A33,33 0 1,0 50,83 A33,33 0 1,0 50,17 Z" />

    <!-- Checkmark tick (bold) -->
    <path android:strokeColor="#10B981"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M28,50 L43,65 L72,36" />
</vector>

