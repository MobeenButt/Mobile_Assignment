<?xml version="1.0" encoding="utf-8"?>
<!-- Circular placeholder for profile image upload -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#0D0D20" />
            <stroke android:width="2dp" android:color="#252545" />
        </shape>
    </item>
    <!-- Inner dashed ring hint -->
    <item android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#40F0B429" />
        </shape>
    </item>
</layer-list>

