<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Checked / selected state: gold fill + border -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#22F0B429" />
            <stroke android:width="1.5dp" android:color="#F0B429" />
        </shape>
    </item>
    <!-- Normal / unchecked state -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#0A0A1C" />
            <stroke android:width="1dp" android:color="#2A2A48" />
        </shape>
    </item>
</selector>

