<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="44dp"
        android:paddingBottom="36dp">

        <!-- ── HEADER ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_logo"
                android:scaleType="fitCenter"
                android:contentDescription="Logo" />

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEP 1 OF 1"
                android:textColor="#3A3A5A"
                android:textSize="10sp"
                android:letterSpacing="0.1" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/reg_title"
            android:textColor="#F0B429"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="@string/reg_subtitle"
            android:textColor="#9090C0"
            android:textSize="13sp" />

        <!-- Top gold rule -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E1E3A"
            android:layout_marginBottom="24dp" />

        <!-- ══════════════════════════════════════
             SECTION: PERSONAL DETAILS
        ══════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="@string/section_personal"
            android:textColor="#F0B429"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.18" />

        <!-- Full Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Full Name"
            android:textColor="#9090C0"
            android:textSize="11sp"
            android:letterSpacing="0.05" />

        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:hint="@string/hint_full_name"
            android:inputType="textPersonName|textCapWords"
            android:background="@drawable/input_bg_selector"
            android:textColor="#F4F0FF"
            android:textColorHint="#5A5A8A"
            android:textSize="15sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:imeOptions="actionNext" />

        <!-- Phone -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Phone Number"
            android:textColor="#9090C0"
            android:textSize="11sp"
            android:letterSpacing="0.05" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:hint="@string/hint_phone"
            android:inputType="phone"
            android:background="@drawable/input_bg_selector"
            android:textColor="#F4F0FF"
            android:textColorHint="#5A5A8A"
            android:textSize="15sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:maxLength="10"
            android:imeOptions="actionNext" />

        <!-- Email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Email Address"
            android:textColor="#9090C0"
            android:textSize="11sp"
            android:letterSpacing="0.05" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="28dp"
            android:hint="@string/hint_email"
            android:inputType="textEmailAddress"
            android:background="@drawable/input_bg_selector"
            android:textColor="#F4F0FF"
            android:textColorHint="#5A5A8A"
            android:textSize="15sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:imeOptions="actionNext" />

        <!-- ══════════════════════════════════════
             SECTION: EVENT DETAILS
        ══════════════════════════════════════ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E1E3A"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="@string/section_event"
            android:textColor="#F0B429"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.18" />

        <!-- Event Type Spinner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Event Type"
            android:textColor="#9090C0"
            android:textSize="11sp"
            android:letterSpacing="0.05" />

        <Spinner
            android:id="@+id/spinnerEventType"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/spinner_bg"
            android:popupBackground="@drawable/spinner_dropdown_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <!-- Event Date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Event Date"
            android:textColor="#9090C0"
            android:textSize="11sp"
            android:letterSpacing="0.05" />

        <!-- Date row: selected date text + button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/input_bg_normal">

            <TextView
                android:id="@+id/tvSelectedDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/no_date_selected"
                android:textColor="#9090C0"
                android:textSize="14sp"
                android:paddingStart="16dp"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnDatePicker"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:text="📅  Pick"
                android:textColor="#07070F"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/btn_gold_filled"
                android:stateListAnimator="@null"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </LinearLayout>

        <!-- Gender -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Gender"
            android:textColor="#9090C0"
            android:textSize="11sp"
            android:letterSpacing="0.05" />

        <RadioGroup
            android:id="@+id/rgGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="28dp">

            <RadioButton
                android:id="@+id/rbMale"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="♂  Male"
                android:textColor="#F4F0FF"
                android:textSize="14sp"
                android:gravity="center"
                android:button="@null"
                android:background="@drawable/radio_btn_bg"
                android:layout_marginEnd="8dp" />

            <RadioButton
                android:id="@+id/rbFemale"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="♀  Female"
                android:textColor="#F4F0FF"
                android:textSize="14sp"
                android:gravity="center"
                android:button="@null"
                android:background="@drawable/radio_btn_bg"
                android:layout_marginEnd="8dp" />

            <RadioButton
                android:id="@+id/rbOther"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Other"
                android:textColor="#F4F0FF"
                android:textSize="14sp"
                android:gravity="center"
                android:button="@null"
                android:background="@drawable/radio_btn_bg" />
        </RadioGroup>

        <!-- ══════════════════════════════════════
             SECTION: PROFILE IMAGE
        ══════════════════════════════════════ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E1E3A"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="@string/section_image"
            android:textColor="#F0B429"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.18" />

        <!-- Image preview + upload button (centered) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="28dp">

            <ImageView
                android:id="@+id/ivProfile"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@drawable/image_placeholder_bg"
                android:scaleType="centerCrop"
                android:contentDescription="Profile image"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnUpload"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="⬆  Upload Image"
                android:textColor="#F0B429"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/btn_gold_outline"
                android:stateListAnimator="@null"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />
        </LinearLayout>

        <!-- ══════════════════════════════════════
             TERMS & SUBMIT
        ══════════════════════════════════════ -->
        <CheckBox
            android:id="@+id/cbTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/label_terms"
            android:textColor="#9090C0"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.3"
            android:buttonTint="#F0B429" />

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_submit"
            android:textColor="#07070F"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:background="@drawable/btn_gold_filled"
            android:stateListAnimator="@null" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

